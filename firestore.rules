rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Primitive Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == "imtyroon@gmail.com"
        && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'provider', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'provider', 'companyName', 'companyUrl', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80
        && data.provider is string && (data.provider == 'google' || data.provider == 'paypal')
        && (!('companyName' in data) || (data.companyName is string && data.companyName.size() <= 60))
        && (!('companyUrl' in data) || (data.companyUrl is string && data.companyUrl.size() <= 120))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'paypalEmail', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'paypalEmail', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$')
        && data.uid == request.auth.uid
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 120
        && data.paypalEmail is string && data.paypalEmail.size() >= 3 && data.paypalEmail.size() <= 120
        && data.updatedAt is timestamp;
    }

    function isValidAuthorizedDomain(data) {
      return data.keys().hasAll(['ownerId', 'domain', 'environment', 'createdAt'])
        && data.keys().hasOnly(['ownerId', 'domain', 'environment', 'createdAt'])
        && data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 && data.ownerId.matches('^[a-zA-Z0-9_\\-]+$')
        && data.ownerId == request.auth.uid
        && data.domain is string && data.domain.size() >= 3 && data.domain.size() <= 120
        && data.environment is string && (data.environment == 'vercel-production' || data.environment == 'vercel-preview' || data.environment == 'custom-domain')
        && data.createdAt is timestamp;
    }

    function isValidAdminPayPalSettings(data) {
      return data.keys().hasAll(['sandboxEnabled', 'environment', 'updatedAt'])
        && data.keys().hasOnly(['sandboxEnabled', 'environment', 'clientIdPrefix', 'webhookId', 'updatedAt'])
        && data.sandboxEnabled is bool
        && data.environment is string && (data.environment == 'SANDBOX' || data.environment == 'LIVE')
        && (!('clientIdPrefix' in data) || (data.clientIdPrefix is string && data.clientIdPrefix.size() <= 64))
        && (!('webhookId' in data) || (data.webhookId is string && data.webhookId.size() <= 120))
        && data.updatedAt is timestamp;
    }

    // 1. User Profile Collection (/users/{userId})
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);

      allow create: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerifiedUser()
        && isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'provider', 'companyName', 'companyUrl', 'updatedAt']);

      allow delete: if false;

      // 2. Isolated User PII Subcollection (/users/{userId}/private/{docId})
      match /private/{docId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && exists(/databases/$(database)/documents/users/$(userId));

        allow create: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming())
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow update: if isVerifiedUser()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(docId)
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'paypalEmail', 'updatedAt'])
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if false;
      }

      // 3. Admin-Only Authorized Vercel & Custom Domains Subcollection (/users/{userId}/domains/{domainId})
      match /domains/{domainId} {
        allow get: if isAdmin()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(domainId)
          && exists(/databases/$(database)/documents/users/$(userId));

        allow list: if isAdmin()
          && isOwner(userId)
          && resource.data.ownerId == request.auth.uid;

        allow create: if isAdmin()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(domainId)
          && isValidAuthorizedDomain(incoming())
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId));

        allow delete: if isAdmin()
          && isOwner(userId)
          && isValidId(userId)
          && isValidId(domainId)
          && exists(/databases/$(database)/documents/users/$(userId));
      }
    }

    // 4. Admin-Only Platform Settings (/admin/{docId}) — Strictly restricted to imtyroon@gmail.com
    match /admin/{docId} {
      allow get: if isAdmin() && isValidId(docId);

      allow create, update: if isAdmin()
        && isValidId(docId)
        && isValidAdminPayPalSettings(incoming())
        && incoming().updatedAt == request.time;

      allow delete: if false;
    }
  }
}
